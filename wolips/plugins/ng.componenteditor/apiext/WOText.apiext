<?xml version="1.0" encoding="UTF-8"?>
<wodefinitions>
	<wo class="WOText" content="forbidden" unknownAttributes="passthrough">

		<doc><![CDATA[A multi-line text input (`<textarea>`). The bound `value` fills the textarea's body on render and receives whatever the user typed on submit — so it is a genuine two-way binding.

Unlike single-line fields, WOText writes `value` into the tag's content rather than a `value` attribute; soft line-wrap returns (`\r\n`) inserted by the browser are stripped before the value is pushed back.]]></doc>

		<binding name="value" required="true">
			<pull><type>java.lang.Object</type></pull>
			<push><type>java.lang.String</type></push>
			<doc><![CDATA[The textarea's text. Required, and must be a settable keypath (a constant is rejected at construction). **Pulled** to fill the textarea body — rendered via `toString()` and HTML-escaped — and **pushed** back as the submitted `java.lang.String` (soft line-wrap returns removed) when the form is submitted.]]></doc>
		</binding>

		<binding name="disabled" defaults="YES/NO">
			<pull><type interpretation="truthy">java.lang.Object</type></pull>
			<doc><![CDATA[If truthy, renders the textarea disabled and skips reading its submitted value, so nothing is **pushed** to `value`. **Pulled** by truthiness.]]></doc>
		</binding>

		<binding name="name">
			<pull><type>java.lang.String</type></pull>
			<doc>The HTML form-field name. Pulled; auto-assigned from the element ID when unbound.</doc>
		</binding>

		<binding name="id">
			<pull><type>java.lang.String</type></pull>
			<doc><![CDATA[The `id` attribute forwarded onto the rendered `<textarea>` tag.]]></doc>
			<deprecated>Write this as a raw HTML attribute on the tag instead of a WO binding.</deprecated>
		</binding>

		<binding name="class">
			<pull><type>java.lang.String</type></pull>
			<doc><![CDATA[The `class` attribute forwarded onto the rendered `<textarea>` tag.]]></doc>
			<deprecated>Write this as a raw HTML attribute on the tag instead of a WO binding.</deprecated>
		</binding>

		<binding name="style">
			<pull><type>java.lang.String</type></pull>
			<doc><![CDATA[The `style` attribute forwarded onto the rendered `<textarea>` tag.]]></doc>
			<deprecated>Write this as a raw HTML attribute on the tag instead of a WO binding.</deprecated>
		</binding>

		<binding name="otherTagString">
			<pull><type>java.lang.String</type></pull>
			<doc>A raw string appended verbatim into the rendered tag's attributes.</doc>
			<deprecated>A WebObjects vestige. Write the attributes directly on the tag instead.</deprecated>
		</binding>

	</wo>
</wodefinitions>
