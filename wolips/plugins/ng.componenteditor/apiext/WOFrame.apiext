<?xml version="1.0" encoding="UTF-8"?>
<wodefinitions>
	<wo class="WOFrame" content="forbidden" unknownAttributes="passthrough">

		<doc><![CDATA[Renders an HTML `<frame>` whose `src` points at another resource, page, or direct action. Supply the frame's URL in exactly one of three ways: a static `src`, a component `value` action, or a `pageName`. Direct-action targets are addressed with `actionClass` and `directActionName`.]]></doc>

		<binding name="src">
			<pull><type>java.lang.String</type></pull>
			<doc><![CDATA[A static URL for the frame. **Pulled** as a string; a relative value is resolved against the application's resources, an absolute one is used verbatim. Mutually exclusive with `value` and `pageName`.]]></doc>
		</binding>

		<binding name="value">
			<pull><type>java.lang.Object</type></pull>
			<doc><![CDATA[A component action backing the frame. **Pulled** and invoked when the frame's URL is requested; its result (a `WOActionResults`, typically a page) is what the frame loads. Mutually exclusive with `src` and `pageName`.]]></doc>
		</binding>

		<binding name="pageName" defaults="Page Names">
			<pull><type>java.lang.String</type></pull>
			<doc><![CDATA[The name of a component to load into the frame. **Pulled** and rendered as a component-action URL; when requested, WebObjects instantiates the named page. Mutually exclusive with `src` and `value`.]]></doc>
		</binding>

		<binding name="actionClass" defaults="Direct Action Classes">
			<pull><type>java.lang.String</type></pull>
			<doc><![CDATA[The direct-action class for the frame's URL. **Pulled** and combined with `directActionName` to build a direct-action URL. Defaults to `DirectAction` when only `directActionName` is bound.]]></doc>
		</binding>

		<binding name="directActionName" defaults="Direct Actions">
			<pull><type>java.lang.String</type></pull>
			<doc><![CDATA[The direct action to target. **Pulled** and combined with `actionClass` to build the frame's direct-action URL.]]></doc>
		</binding>

		<choose min="1" max="1">
			<binding name="src"/>
			<binding name="pageName"/>
			<binding name="value"/>
		</choose>

	</wo>
</wodefinitions>
