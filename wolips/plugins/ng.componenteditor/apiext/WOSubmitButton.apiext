<?xml version="1.0" encoding="UTF-8"?>
<wodefinitions>
	<wo class="WOSubmitButton" content="forbidden" unknownAttributes="passthrough">

		<doc><![CDATA[A form submit button (`<input type="submit">`). Clicking it submits the enclosing form and triggers a component `action` — or, via `actionClass`/`directActionName`, a direct action.

Bind **either** `action`, **or** one or both of `actionClass`/`directActionName` — never both an `action` and a direct-action binding. The button label comes from `value` (default `Submit`).]]></doc>

		<binding name="action">
			<pull><type>com.webobjects.appserver.WOActionResults</type></pull>
			<doc><![CDATA[A component action to invoke when the button is clicked. **Pulled** on submit; its result (a `WOActionResults`, typically the next page) becomes the response, or the current page if it returns `null`. Must be a resolvable keypath — a constant `action` is rejected at parse time. Mutually exclusive with `actionClass`/`directActionName`.]]></doc>
		</binding>

		<binding name="actionClass" defaults="Direct Action Classes">
			<pull><type>java.lang.String</type></pull>
			<doc><![CDATA[The direct-action class to target. **Pulled** and combined with `directActionName` to build the form's action URL. Use instead of `action` for a direct action; mutually exclusive with `action`.]]></doc>
		</binding>

		<binding name="directActionName" defaults="Direct Actions">
			<pull><type>java.lang.String</type></pull>
			<doc><![CDATA[The direct-action method name to target. **Pulled** and combined with `actionClass` to build the form's action URL. Use instead of `action` for a direct action; mutually exclusive with `action`.]]></doc>
		</binding>

		<binding name="value">
			<pull><type>java.lang.Object</type></pull>
			<default>Submit</default>
			<doc><![CDATA[The button's label (the `value` attribute). **Pulled** and rendered as text; defaults to `Submit` when unbound. Unlike other inputs, a submit button never **pushes** its value back — the value is not writable.]]></doc>
		</binding>

		<binding name="name">
			<pull><type>java.lang.String</type></pull>
			<doc><![CDATA[The HTML form-field name. Pulled; auto-assigned from the element ID when unbound. When a direct action is used, the name is derived from `actionClass`/`directActionName` instead.]]></doc>
		</binding>

		<binding name="disabled" defaults="YES/NO">
			<pull><type interpretation="truthy">java.lang.Object</type></pull>
			<doc><![CDATA[If truthy, renders the button disabled and skips invoking its `action` on submit.]]></doc>
		</binding>

		<binding name="id">
			<pull><type>java.lang.String</type></pull>
			<doc><![CDATA[The `id` attribute forwarded onto the rendered `<input>` tag.]]></doc>
			<deprecated>Write this as a raw HTML attribute on the tag instead of a WO binding.</deprecated>
		</binding>

		<binding name="class">
			<pull><type>java.lang.String</type></pull>
			<doc><![CDATA[The `class` attribute forwarded onto the rendered `<input>` tag.]]></doc>
			<deprecated>Write this as a raw HTML attribute on the tag instead of a WO binding.</deprecated>
		</binding>

		<binding name="style">
			<pull><type>java.lang.String</type></pull>
			<doc><![CDATA[The `style` attribute forwarded onto the rendered `<input>` tag.]]></doc>
			<deprecated>Write this as a raw HTML attribute on the tag instead of a WO binding.</deprecated>
		</binding>

		<binding name="otherTagString">
			<pull><type>java.lang.String</type></pull>
			<doc>A raw string appended verbatim into the rendered tag's attributes.</doc>
			<deprecated>A WebObjects vestige. Write the attributes directly on the tag instead.</deprecated>
		</binding>

		<choose min="1" max="1">
			<binding name="action"/>
			<any-of><binding name="actionClass"/><binding name="directActionName"/></any-of>
		</choose>
		<requires binding="action" must="gettable"/>

	</wo>
</wodefinitions>
