<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE wodefinitions SYSTEM "apiext.dtd">
<wodefinitions>
	<wo class="WOString">
		<doc><![CDATA[
Renders a dynamic string into the page. The bound `value` is converted to text and HTML-escaped by default.

Use a `dateformat`, `numberformat`, or `formatter` to format non-string values, and `valueWhenEmpty` to substitute a placeholder when the value is null or empty.
		]]></doc>

		<binding name="value" required="true">
			<type>java.lang.Object</type>
			<doc>The value to display. Required. Formatted to a string, then HTML-escaped unless `escapeHTML` is `false`.</doc>
		</binding>
		<binding name="escapeHTML" defaults="YES/NO">
			<type>java.lang.Boolean</type>
			<doc>Whether to HTML-escape the rendered value. Defaults to `true`; set `false` only when `value` is already safe markup.</doc>
		</binding>
		<binding name="dateformat" defaults="Date Format Strings">
			<type>java.lang.String</type>
			<doc>A date format pattern used to render a date `value`. Mutually exclusive with `numberformat` and `formatter`.</doc>
		</binding>
		<binding name="numberformat" defaults="Number Format Strings">
			<type>java.lang.String</type>
			<doc>A number format pattern used to render a numeric `value`. Mutually exclusive with `dateformat` and `formatter`.</doc>
		</binding>
		<binding name="formatter">
			<type>java.text.Format</type>
			<doc>A `Format` instance used to render `value`. Mutually exclusive with `dateformat` and `numberformat`.</doc>
		</binding>
		<binding name="valueWhenEmpty">
			<type>java.lang.Object</type>
			<doc>Substituted when `value` is null or empty, so the element still renders something.</doc>
		</binding>

		<validation message="no more than one of 'dateformat', 'numberformat', or 'formatter' may be bound"/>
	</wo>
</wodefinitions>
