<?xml version="1.0" encoding="UTF-8"?>
<wodefinitions>
	<wo class="WOCheckBox" wrapsContent="false" unknownAttributes="passthrough">

		<doc><![CDATA[A checkbox (`<input type="checkbox">`). Use **either** `checked` (a truthy in, a Boolean out) **or** `value`+`selection` (membership-style) — not both.]]></doc>

		<binding name="checked">
			<pull><type interpretation="truthy">java.lang.Object</type></pull>
			<push><type>java.lang.Boolean</type></push>
			<doc><![CDATA[The checked state. **Pulled** by truthiness to decide the initial state (`null`/`0`/`false` → unchecked); **pushed** back as a `java.lang.Boolean` — `true` if the user left it checked, `false` otherwise. Mutually exclusive with `value`.]]></doc>
		</binding>

		<binding name="value">
			<pull><type>java.lang.Object</type></pull>
			<doc><![CDATA[This checkbox's value (the `value` attribute). With `selection`, the box is checked when `selection` equals `value`. Mutually exclusive with `checked`.]]></doc>
		</binding>

		<binding name="selection">
			<pull><type>java.lang.Object</type></pull>
			<push><type>java.lang.Object</type></push>
			<doc><![CDATA[The selected value (used with `value`). On submit it is set to `value` when the box is checked, or nulled when unchecked.]]></doc>
		</binding>

		<binding name="name">
			<pull><type>java.lang.String</type></pull>
			<doc>The HTML form-field name (auto-assigned if unbound).</doc>
		</binding>

		<binding name="disabled">
			<pull><type interpretation="truthy">java.lang.Object</type></pull>
			<doc><![CDATA[If truthy, renders the checkbox disabled (its `selection` won't be submitted).]]></doc>
		</binding>

		<choose min="1" max="1">
			<binding name="checked"/>
			<binding name="value"/>
		</choose>
		<requires binding="selection" when="value"/>
		<requires binding="value" when="selection"/>

	</wo>
</wodefinitions>
