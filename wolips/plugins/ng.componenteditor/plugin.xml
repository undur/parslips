         <action class="org.objectstyle.wolips.componenteditor.actions.InsertAnyComponentAction"
               icon="icons/anycomponent.png"
               id="ng.componenteditor.actions.InsertAnyComponentAction"
               definitionId="ng.componenteditor.editors.command.InsertAnyComponentAction"
               label="Insert Component"
               menubarPath="edit/ng.componenteditor.insertMenuContribution/group1"
               style="push"
               toolbarPath="/Normal/additions"
               tooltip="Insert Component"/>
         <action class="org.objectstyle.wolips.componenteditor.actions.InsertComponentWOFormAction"
