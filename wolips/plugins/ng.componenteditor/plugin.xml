         <action class="org.objectstyle.wolips.componenteditor.actions.InsertComponentWORadioButtonAction"
               icon="icons/radio.png"
               id="ng.componenteditor.actions.InsertComponentWORadioButton"
               label="Insert WORadioButton Component"
               menubarPath="edit/ng.componenteditor.insertMenuContribution/group1"
               style="push"
               toolbarPath="/Normal/additions"
               tooltip="Insert WORadioButton Component"/>
         <action class="org.objectstyle.wolips.componenteditor.actions.InsertComponentWOSubmitButtonAction"
               icon="icons/submit.png"
               id="ng.componenteditor.actions.InsertComponentWOSubmitButton"
               label="Insert WOSubmitButton Component"
               menubarPath="edit/ng.componenteditor.insertMenuContribution/group1"
               style="push"
               toolbarPath="/Normal/additions"
