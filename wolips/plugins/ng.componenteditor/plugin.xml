<!-- Parsley Perspective                                                                 -->
<!-- =================================================================================== -->
   <extension point="org.eclipse.ui.perspectives">
      <perspective
            name="Parsley"
            icon="icons/parsley16.png"
            class="ng.componenteditor.NGPerspectiveFactory"
            id="ng.componenteditor.ParsleyPerspective"/>
   </extension>

   <extension point="org.eclipse.ui.perspectiveExtensions">
      <perspectiveExtension targetID="ng.componenteditor.ParsleyPerspective">
         <perspectiveShortcut id="org.eclipse.debug.ui.DebugPerspective"/>
