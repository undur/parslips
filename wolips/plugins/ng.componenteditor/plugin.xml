               style="push"
               toolbarPath="/Normal/additions"
               tooltip="Insert WOForm Component"/>
         <action class="org.objectstyle.wolips.componenteditor.actions.InsertComponentWOBrowserAction"
               icon="icons/browser.png"
               id="ng.componenteditor.actions.InsertComponentWOBrowser"
               label="Insert WOBrowser Component"
               menubarPath="edit/ng.componenteditor.insertMenuContribution/group1"
               style="push"
               toolbarPath="/Normal/additions"
               tooltip="Insert WOBrowser Component"/>
         <action class="org.objectstyle.wolips.componenteditor.actions.InsertComponentWOPopUpButtonAction"
               icon="icons/popup.png"
               id="ng.componenteditor.actions.InsertComponentWOPopUpButton"
               label="Insert WOPopUpButton Component"
               menubarPath="edit/ng.componenteditor.insertMenuContribution/group1"
               style="push"
               toolbarPath="/Normal/additions"
               tooltip="Insert WOPopUpButton Component"/>
         <action class="org.objectstyle.wolips.componenteditor.actions.InsertComponentWOTextAction"
               icon="icons/textarea.png"
               id="ng.componenteditor.actions.InsertComponentWOText"
               label="Insert WOText Component"
               menubarPath="edit/ng.componenteditor.insertMenuContribution/group1"
               style="push"
               toolbarPath="/Normal/additions"
               tooltip="Insert WOText Component"/>
         <action class="org.objectstyle.wolips.componenteditor.actions.InsertComponentWOCheckBoxAction"
               icon="icons/checkbox.png"
               id="ng.componenteditor.actions.InsertComponentWOCheckBox"
               label="Insert WOCheckBox Component"
               menubarPath="edit/ng.componenteditor.insertMenuContribution/group1"
