<!-- =================================================================================== -->
<!-- Views                                                                               -->
<!-- =================================================================================== -->
   <extension point="org.eclipse.ui.views">
      <category name="NG Component Editor" id="ng.componenteditor.views"/>
      <view name="Bindings Inspector"
            category="ng.componenteditor.views"
            class="org.objectstyle.wolips.componenteditor.inspector.BindingsInspectorPageBookView"
            id="ng.componenteditor.inspector.BindingsInspectorPageBookView"/>
      <view name="Parsley Explorer"
            allowMultiple="false"
            category="ng.componenteditor.views"
            class="ng.componenteditor.explorer.NGPackageExplorerPart"
            icon="icons/parsley16.png"
            id="ng.componenteditor.explorer.NGPackageExplorer"/>
   </extension>

<!-- =================================================================================== -->
<!-- Action Sets                                                                         -->
<!-- =================================================================================== -->
   <extension point="org.eclipse.ui.actionSets">
      <actionSet id="ng.componenteditor.actionSet"
            label="NG Component Action Sets"
            visible="true">
         <action class="org.objectstyle.wolips.componenteditor.actions.OpenComponentAction"
               definitionId="ng.componenteditor.openComponent"
               id="ng.componenteditor.openComponent"
               label="Open Component..."
               menubarPath="navigate/open.ext2"/>
      </actionSet>
   </extension>

<!-- =================================================================================== -->
<!-- New Wizards                                                                         -->
<!-- =================================================================================== -->
   <extension point="org.eclipse.ui.newWizards">
      <category
            id="ng.componenteditor.newWizards"
            name="NG Objects"/>
      <wizard
            category="ng.componenteditor.newWizards"
            class="org.objectstyle.wolips.wizards.WOComponentCreationWizard"
            icon="icons/wobuilder/WOComponentBundle.png"
            id="ng.componenteditor.newWOComponentWizard"
            name="NG Component">
         <description>Create a new NG component</description>
      </wizard>
   </extension>

<!-- =================================================================================== -->
<!-- Popup Menus                                                                         -->
<!-- =================================================================================== -->
   <extension point="org.eclipse.ui.popupMenus">
      <objectContribution adaptable="false"
            id="ng.componenteditor.generateAPI.woContribution"
            nameFilter="*.wo"
            objectClass="org.eclipse.core.resources.IFolder">
         <action class="org.objectstyle.wolips.wodclipse.action.GenerateAPIAction"
               enablesFor="*"
               icon="icons/file-api.png"
               id="ng.componenteditor.generateAPIActionForWO"
               label="Generate API File"
               menubarPath="additions"/>
      </objectContribution>
   </extension>

<!-- =================================================================================== -->
<!-- Preference Pages                                                                    -->
<!-- =================================================================================== -->
   <extension point="org.eclipse.ui.preferencePages">
      <page class="tk.eclipse.plugin.htmleditor.HTMLEditorPreferencePage"
            id="ng.componenteditor.preferences"
            name="NG Component Editor"/>
      <page class="tk.eclipse.plugin.htmleditor.XMLPreferencePage"
            category="ng.componenteditor.preferences"
            id="ng.componenteditor.preferences.XML"
            name="Template Formatting"/>
      <page class="org.objectstyle.wolips.wodclipse.core.preferences.WodEditorPreferencePage"
            category="ng.componenteditor.preferences"
            id="ng.componenteditor.preferences.WodEditor"
            name="WOD Editor"/>
      <page class="org.objectstyle.wolips.bindings.preferences.TagShortcutPreferencePage"
            category="ng.componenteditor.preferences"
            id="ng.componenteditor.preferences.TagShortcuts"
            name="Inline Binding Shortcuts"/>
      <page class="org.objectstyle.wolips.bindings.preferences.BindingValidationRulePreferencePage"
            category="ng.componenteditor.preferences"
            id="ng.componenteditor.preferences.ValidationRules"
            name="Validation Rules"/>
      <page class="org.objectstyle.wolips.bindings.preferences.BindingValidationPreferencePage"
            category="ng.componenteditor.preferences"
            id="ng.componenteditor.preferences.Validation"
            name="Validation"/>
   </extension>

<!-- =================================================================================== -->
<!-- Preference Initializers                                                             -->
<!-- =================================================================================== -->
   <extension point="org.eclipse.core.runtime.preferences">
      <initializer class="tk.eclipse.plugin.htmleditor.HTMLPreferenceInitializer"/>
      <initializer class="org.objectstyle.wolips.wodclipse.core.preferences.PreferenceInitializer"/>
      <initializer class="org.objectstyle.wolips.bindings.preferences.PreferenceInitializer"/>
   </extension>

<!-- =================================================================================== -->
<!-- Markers                                                                             -->
<!-- =================================================================================== -->
   <extension id="problem" name="NG Template Problems"
         point="org.eclipse.core.resources.markers">
      <super type="org.eclipse.core.resources.problemmarker"/>
      <super type="org.eclipse.core.resources.textmarker"/>
      <persistent value="true"/>
   </extension>

<!-- =================================================================================== -->
<!-- Annotation Types                                                                    -->
<!-- =================================================================================== -->
   <extension point="org.eclipse.ui.editors.annotationTypes">
      <type name="ng.componenteditor.bindingHover"/>
   </extension>
   <extension point="org.eclipse.ui.editors.markerAnnotationSpecification">
      <specification
            annotationType="ng.componenteditor.bindingHover"
            colorPreferenceKey="bindingHoverColor"
            colorPreferenceValue="240,220,0"
            highlightPreferenceKey="bindingHoverHighlight"
            highlightPreferenceValue="true"
            includeOnPreferencePage="true"
            label="Binding Hover"
            overviewRulerPreferenceKey="bindingHoverOverviewRuler"
            overviewRulerPreferenceValue="false"
            presentationLayer="6"
            textPreferenceKey="bindingHoverIndication"
            textPreferenceValue="false"
            textStylePreferenceKey="bindingHoverTextStyle"
            textStylePreferenceValue="BOX"
            verticalRulerPreferenceKey="bindingHoverVerticalRuler"
            verticalRulerPreferenceValue="false"/>
   </extension>

<!-- =================================================================================== -->
<!-- Templates                                                                           -->
<!-- =================================================================================== -->
   <extension point="org.eclipse.ui.editors.templates">
      <contextType class="tk.eclipse.plugin.htmleditor.template.HTMLContextType"
            name="HTML/JSP/XML"
            id="ng.componenteditor.templateContextType.html"/>
      <contextType class="tk.eclipse.plugin.htmleditor.template.JavaScriptContextType"
            name="JavaScript"
            id="ng.componenteditor.templateContextType.javascript"/>
   </extension>

<!-- =================================================================================== -->
<!-- WOD Builder (registers with the ng.componenteditor.builders extension point)        -->
<!-- =================================================================================== -->
   <extension point="ng.componenteditor.builders">
      <builder class="org.objectstyle.wolips.wodclipse.core.builder.WodBuilder"
            id="ng.componenteditor.builder.WodBuilder"
            name="Wod Builder"/>
   </extension>

<!-- =================================================================================== -->
<!-- Adapters (from core plugin)                                                         -->
<!-- =================================================================================== -->
   <extension point="org.eclipse.core.runtime.adapters">
      <factory class="org.objectstyle.wolips.core.resources.internal.types.ProjectAdapterFactory"
            adaptableType="org.eclipse.core.resources.IProject">
         <adapter type="org.objectstyle.wolips.core.resources.types.ProjectAdapter"/>
      </factory>
   </extension>

<!-- =================================================================================== -->
<!-- Element Factories (for editor state persistence)                                    -->
<!-- =================================================================================== -->
   <extension point="org.eclipse.ui.elementFactories">
      <factory
            class="org.objectstyle.wolips.components.input.ComponentEditorInputFactory"
            id="org.objectstyle.wolips.components.input.ComponentEditorInputFactory"/>
   </extension>

<!-- =================================================================================== -->
<!-- Document Providers (from wooeditor)                                                 -->
<!-- =================================================================================== -->
   <extension point="org.eclipse.ui.editors.documentProviders">
      <provider class="org.eclipse.ui.editors.text.TextFileDocumentProvider"
            id="ng.componenteditor.NullDocumentProvider"
            inputTypes="org.objectstyle.wolips.wooeditor.NonExistingFileEditorInput"/>
   </extension>

<!-- =================================================================================== -->
<!-- File assist processor (internal extension)                                          -->
<!-- =================================================================================== -->
   <extension point="ng.componenteditor.fileAssistProcessor">
      <processor class="tk.eclipse.plugin.htmleditor.assist.FileAssistProcessor"/>
   </extension>

<!-- =================================================================================== -->
<!-- BuildProperties adapter factory (from variables plugin)                             -->
<!-- =================================================================================== -->
   <extension point="org.eclipse.core.runtime.adapters">
      <factory
            adaptableType="org.eclipse.core.resources.IProject"
            class="org.objectstyle.wolips.variables.BuildPropertiesAdapterFactory">
         <adapter
               type="org.objectstyle.wolips.variables.BuildProperties">
         </adapter>
      </factory>
   </extension>

<!-- =================================================================================== -->
<!-- Editor Association Override (prefer NG editor for ng projects)                      -->
<!-- =================================================================================== -->
   <extension point="org.eclipse.ui.ide.editorAssociationOverride">
      <editorAssociationOverride
            id="ng.componenteditor.editorAssociationOverride"
            class="org.objectstyle.wolips.componenteditor.part.NGEditorAssociationOverride"/>
   </extension>

<!-- =================================================================================== -->
<!-- Parsley Explorer View Filters (mirror of JDT Package Explorer standard filters)    -->
<!-- =================================================================================== -->
   <extension point="org.eclipse.jdt.ui.javaElementFilters">
      <filter
            id="ng.componenteditor.explorer.ClosedProjectsFilter"
            name="Closed projects"
            description="Hides closed projects"
            class="org.eclipse.jdt.internal.ui.filters.ClosedProjectFilter"
            enabled="true"
            targetId="ng.componenteditor.explorer.NGPackageExplorer"/>
      <filter
            id="ng.componenteditor.explorer.NonJavaProjectsFilter"
            name="Non-Java projects"
            description="Hides non-Java projects"
            class="org.eclipse.jdt.internal.ui.filters.NonJavaProjectFilter"
            enabled="false"
            targetId="ng.componenteditor.explorer.NGPackageExplorer"/>
      <filter
            id="ng.componenteditor.explorer.NonJavaElementFilter"
            name="Non-Java elements"
            description="Hides non-Java elements"
            class="org.eclipse.jdt.internal.ui.filters.NonJavaElementFilter"
            enabled="false"
            targetId="ng.componenteditor.explorer.NGPackageExplorer"/>
      <filter
            id="ng.componenteditor.explorer.EmptyPackageFilter"
            name="Empty packages"
            description="Hides empty packages"
            class="org.eclipse.jdt.internal.ui.filters.EmptyPackageFilter"
            enabled="false"
            targetId="ng.componenteditor.explorer.NGPackageExplorer"/>
      <filter
            id="ng.componenteditor.explorer.EmptyInnerPackageFilter"
            name="Empty parent packages"
            description="Hides empty parent packages (compresses the package tree)"
            class="org.eclipse.jdt.internal.ui.filters.EmptyInnerPackageFilter"
            enabled="false"
            targetId="ng.componenteditor.explorer.NGPackageExplorer"/>
      <filter
            id="ng.componenteditor.explorer.LibraryFilter"
            name="Referenced libraries"
            description="Hides referenced libraries"
            class="org.eclipse.jdt.internal.ui.filters.LibraryFilter"
            enabled="false"
            targetId="ng.componenteditor.explorer.NGPackageExplorer"/>
      <filter
            id="ng.componenteditor.explorer.ContainedLibraryFilter"
            name="Contained libraries"
            description="Hides libraries contained within a project (e.g. lib/ JARs on the classpath)"
            class="org.eclipse.jdt.internal.ui.filters.ContainedLibraryFilter"
            enabled="false"
            targetId="ng.componenteditor.explorer.NGPackageExplorer"/>
      <filter
            id="ng.componenteditor.explorer.InnerClassFilesFilter"
            name="Inner class files"
            description="Hides inner class files in source folders"
            class="org.eclipse.jdt.internal.ui.filters.InnerClassFilesFilter"
            enabled="true"
            targetId="ng.componenteditor.explorer.NGPackageExplorer"/>
      <filter
            id="ng.componenteditor.explorer.PackageDeclarationFilter"
            name="Package declarations"
            description="Hides package declarations"
            class="org.eclipse.jdt.internal.ui.filters.PackageDeclarationFilter"
            enabled="true"
            targetId="ng.componenteditor.explorer.NGPackageExplorer"/>
      <filter
            id="ng.componenteditor.explorer.ImportDeclarationFilter"
            name="Import declarations"
            description="Hides import declarations"
            class="org.eclipse.jdt.internal.ui.filters.ImportDeclarationFilter"
            enabled="true"
            targetId="ng.componenteditor.explorer.NGPackageExplorer"/>
      <filter
            id="ng.componenteditor.explorer.SyntheticMembersFilter"
            name="Synthetic members"
            description="Hides synthetic (compiler-generated) members"
            class="org.eclipse.jdt.internal.ui.filters.SyntheticMembersFilter"
            enabled="true"
            targetId="ng.componenteditor.explorer.NGPackageExplorer"/>
      <filter
            id="ng.componenteditor.explorer.DeprecatedFilter"
            name="Deprecated fields and methods"
            description="Hides deprecated fields and methods"
            class="org.eclipse.jdt.internal.ui.filters.DeprecatedFieldsAndMethodsFilter"
            enabled="false"
            targetId="ng.componenteditor.explorer.NGPackageExplorer"/>
      <filter
            id="ng.componenteditor.explorer.FieldsFilter"
            name="Fields"
            description="Hides all fields"
            class="org.eclipse.jdt.internal.ui.filters.FieldsFilter"
            enabled="false"
            targetId="ng.componenteditor.explorer.NGPackageExplorer"/>
      <filter
            id="ng.componenteditor.explorer.StaticsFilter"
            name="Static members"
            description="Hides all static fields and methods"
            class="org.eclipse.jdt.internal.ui.filters.StaticsFilter"
            enabled="false"
            targetId="ng.componenteditor.explorer.NGPackageExplorer"/>
      <filter
            id="ng.componenteditor.explorer.NonPublicFilter"
            name="Non-public members"
            description="Hides all non-public members"
            class="org.eclipse.jdt.internal.ui.filters.NonPublicFilter"
            enabled="false"
            targetId="ng.componenteditor.explorer.NGPackageExplorer"/>
      <!-- Pattern-based filters (no code needed) -->
      <filter
            id="ng.componenteditor.explorer.DotFilesFilter"
            name="System files (.*)"
            description="Hides files and folders whose names start with a dot"
            pattern=".*"
            enabled="true"
            targetId="ng.componenteditor.explorer.NGPackageExplorer"/>
      <filter
            id="ng.componenteditor.explorer.BuildXmlFilter"
            name="build.xml"
            description="Hides Ant build.xml files"
            pattern="build.xml"
            enabled="false"
            targetId="ng.componenteditor.explorer.NGPackageExplorer"/>
      <filter
            id="ng.componenteditor.explorer.XcodeFilesFilter"
            name="Xcode files"
            description="Hides Xcode project files (*.xcode*)"
            pattern="*.xcode*"
            enabled="true"
            targetId="ng.componenteditor.explorer.NGPackageExplorer"/>
   </extension>

<!-- =================================================================================== -->
<!-- Decorators (custom icons for .wo component bundles in all views)                    -->
<!-- =================================================================================== -->
   <extension point="org.eclipse.ui.decorators">
      <decorator
            class="ng.componenteditor.explorer.WOComponentDecorator"
            id="ng.componenteditor.decorator.WOComponentDecorator"
            label="NG Component Decorator"
            lightweight="false"
            state="true">
         <enablement>
            <and>
               <objectClass name="org.eclipse.core.resources.IFolder"/>
               <objectState
                     name="extension"
                     value="wo"/>
            </and>
         </enablement>
      </decorator>
      <decorator
            class="ng.componenteditor.explorer.ProjectDecorator"
            id="ng.componenteditor.decorator.ProjectDecorator"
            label="NG/WO Project Decorator"
            lightweight="false"
            adaptable="true"
            state="true">
         <description>
            Adds ng-objects or WebObjects badge to recognized projects
         </description>
         <enablement>
            <or>
               <objectClass name="org.eclipse.core.resources.IProject"/>
               <objectClass name="org.eclipse.jdt.core.IJavaProject"/>
            </or>
         </enablement>
      </decorator>
   </extension>

