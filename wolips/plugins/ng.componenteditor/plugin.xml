         <action class="org.objectstyle.wolips.componenteditor.actions.InsertComponentWOTextFieldAction"
               icon="icons/textfield.png"
               id="ng.componenteditor.actions.InsertComponentWOTextField"
               label="Insert WOTextField Component"
               menubarPath="edit/ng.componenteditor.insertMenuContribution/group1"
               style="push"
               toolbarPath="/Normal/additions"
               tooltip="Insert WOTextField Component"/>
         <action class="org.objectstyle.wolips.componenteditor.actions.InsertComponentWOHyperlinkAction"
               icon="icons/hyperlink.png"
               id="ng.componenteditor.actions.InsertComponentWOHyperlink"
               label="Insert WOHyperlink Component"
               menubarPath="edit/ng.componenteditor.insertMenuContribution/group1"
               style="push"
